{
  "name": "@local/dsh-capinfo",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "Capinfo models, API credentials and daily CNY spending and token history for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./usage-service": {
      "types": "./usage-service.d.ts",
      "default": "./usage-service.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "spending.js",
    "usage.js",
    "usage-service.js",
    "usage-service.d.ts",
    "index.js",
    "capinfo-service.js",
    "owned-provider.js",
    "provider-runtime.js",
    "provider-profile.js",
    "model-discovery.js",
    "vision-capabilities.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "client.js.LEGAL.txt",
    "client-source.js",
    "usage-chart.js",
    "usage-chart-options.js",
    "scripts/build-client.mjs",
    "vendor",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check spending.js && node --check usage.js && node --check usage-service.js && node --check index.js && node --check capinfo-service.js && node --check owned-provider.js && node --check provider-runtime.js && node --check provider-profile.js && node --check model-discovery.js && node --check vision-capabilities.js && node --check client.js && node --check client-source.js && node --check usage-chart.js && node --check usage-chart-options.js && node scripts/build-client.mjs --check",
    "build": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "1.3.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "echarts": "6.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "esbuild": "0.25.12",
    "semver": "7.8.6"
  }
}
